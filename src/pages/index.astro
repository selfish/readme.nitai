---
import {
  links,
  openQuestions,
  principles,
  profile,
  systemLoop,
  workingContract,
} from "../content";
import "../styles/global.css";

const title = "Unpublished draft — Nitai Perez README";
const description =
  "An unpublished, approval-gated design and copy draft for Nitai Perez’s working README.";
const canonicalUrl = new URL("/", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f3efe6" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" aria-label="Page header">
      <a class="identity" href="#top" aria-label="Nitai Perez — back to the top">
        <span>{profile.name}</span>
        <span>{profile.label}</span>
      </a>
      <nav aria-label="On this page">
        <a href="#thinking">Starting points</a>
        <a href="#contract">Contract questions</a>
        <a href="#questions">Owner questions</a>
      </nav>
      <p class="edition" aria-label={`Draft edition ${profile.edition}`}>Draft / {profile.edition}</p>
    </header>

    <main id="main" tabindex="-1">
      <article id="top">
        <header class="hero">
          <div class="hero-copy">
            <div class="hero-meta">
              <p>{profile.label}</p>
              <p class="draft-status">{profile.status}</p>
            </div>
            <h1>{profile.name}</h1>
            <p class="thesis">{profile.thesis}</p>
            <p class="introduction">{profile.introduction}</p>
          </div>

          <aside class="operating-loop" aria-labelledby="operating-loop-title">
            <p class="aside-label" id="operating-loop-title">The approval path</p>
            <ol role="list">
              {
                systemLoop.map((step, index) => (
                  <li>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{step}</strong>
                  </li>
                ))
              }
            </ol>
            <p class="loop-note">
              Source first. Approval second. Publication remains a separate decision.
            </p>
          </aside>
        </header>

        <div class="reading-layout">
          <aside class="contents" aria-label="Contents">
            <p class="aside-label">Contents</p>
            <ol role="list">
              {
                principles.map((principle, index) => (
                  <li>
                    <a href={`#${principle.id}`}>
                      <span>{String(index + 1).padStart(2, "0")}</span>
                      {principle.title}
                    </a>
                  </li>
                ))
              }
            </ol>
            <p class="contents-note">Three source-backed phrases. The explanations are questions, not Nitai’s claims.</p>
          </aside>

          <div class="document">
            <section class="thinking" id="thinking" aria-labelledby="thinking-title">
              <header class="section-heading">
                <p class="section-label">01 / Evidence</p>
                <div>
                  <h2 id="thinking-title">Three starting points</h2>
                  <p>
                    Public wording can establish the premise. Only Nitai’s answers can turn it into a working model.
                  </p>
                </div>
              </header>

              <div class="principles">
                {
                  principles.map((principle, index) => (
                    <article class="principle" id={principle.id} aria-labelledby={`${principle.id}-title`}>
                      <header>
                        <p class="principle-index">{String(index + 1).padStart(2, "0")}</p>
                        <div>
                          <p class="kicker">{principle.kicker}</p>
                          <h3 id={`${principle.id}-title`}>{principle.title}</h3>
                        </div>
                      </header>
                      <div class="principle-copy">
                        <p class="lede">{principle.lede}</p>
                        <div class="prose-columns">
                          {principle.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                        </div>
                        <dl class="notes">
                          {principle.notes.map((note) => (
                            <div>
                              <dt>{note.label}</dt>
                              <dd>{note.detail}</dd>
                            </div>
                          ))}
                        </dl>
                      </div>
                    </article>
                  ))
                }
              </div>
            </section>

            <section class="contract" id="contract" aria-labelledby="contract-title">
              <header class="section-heading">
                <p class="section-label">02 / Interface draft</p>
                <div>
                  <h2 id="contract-title">Questions, not a contract</h2>
                  <p>This matrix tests the information architecture without inventing promises or expectations.</p>
                </div>
              </header>

              <div class="contract-grid" role="table" aria-label="Questions for a future working contract">
                <div class="contract-header" role="row">
                  <span role="columnheader">Situation</span>
                  <span role="columnheader">Questions for Nitai</span>
                  <span role="columnheader">Questions for teammates</span>
                </div>
                {
                  workingContract.map((item) => (
                    <div class="contract-row" role="row">
                      <strong role="cell">{item.situation}</strong>
                      <span role="cell">{item.fromMe}</span>
                      <span role="cell">{item.fromYou}</span>
                    </div>
                  ))
                }
              </div>
            </section>

            <section class="questions" id="questions" aria-labelledby="questions-title">
              <header class="section-heading">
                <p class="section-label">03 / Owner input</p>
                <div>
                  <h2 id="questions-title">What the real version must answer</h2>
                  <p>
                    These are the factual gaps recorded in issue #1. They remain unanswered unless Nitai says otherwise.
                  </p>
                </div>
              </header>
              <ol role="list">
                {openQuestions.map((question, index) => <li><span>{index + 1}</span>{question}</li>)}
              </ol>
            </section>
          </div>
        </div>
      </article>
    </main>

    <footer>
      <div>
        <p class="footer-title">README / {profile.name}</p>
        <p class="footer-note">An unpublished discussion artifact—not Nitai’s working model until he approves it.</p>
      </div>
      <nav aria-label="Elsewhere">
        {
          links.map((link) => (
            <a href={link.href} rel="noreferrer">{link.label}<span class="external" aria-hidden="true">↗</span></a>
          ))
        }
      </nav>
    </footer>
  </body>
</html>
